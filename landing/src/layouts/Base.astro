---
import "@/styles/global.css"

interface Props {
  title?: string
  description?: string
}

const {
  title = "mole — SSH port forwarding, auto-discovered",
  description = "SSH port forwarding that auto-discovers your remote's listeners. One binary, one connection, zero port lists.",
} = Astro.props

// Self-hosted analytics. Both halves of the pair have to be set or nothing is
// emitted, so `astro dev` and a local build never report a page view into the
// production dataset. The website id is a UUID the instance mints at runtime,
// which is why it is environment and not a constant in here.
const umamiScript = import.meta.env.MOLE_UMAMI_SCRIPT_URL
const umamiWebsiteId = import.meta.env.MOLE_UMAMI_WEBSITE_ID
const umami = umamiScript && umamiWebsiteId

// Absolute and derived from `site`: a relative `og:image` is not resolved by
// most crawlers, and a canonical has to be one spelling of one URL.
const canonical = new URL(Astro.url.pathname, Astro.site).href
const preview = new URL("/og.png", Astro.site).href
const repository = "https://github.com/Luqueee/mole"

// One graph rather than three scripts: `SoftwareApplication` is what an answer
// engine reads to say what mole is, and `WebSite` ties the pages together and
// points at the software by `@id` instead of repeating it.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": new URL("/#software", Astro.site).href,
      name: "mole",
      description,
      applicationCategory: "DeveloperApplication",
      applicationSubCategory: "SSH port forwarding",
      operatingSystem: "Linux, macOS, Windows, FreeBSD",
      url: new URL("/", Astro.site).href,
      codeRepository: repository,
      license: "https://spdx.org/licenses/MIT.html",
      programmingLanguage: "Go",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    },
    {
      "@type": "WebSite",
      "@id": new URL("/#website", Astro.site).href,
      name: "mole",
      description,
      url: new URL("/", Astro.site).href,
      inLanguage: "en",
      about: { "@id": new URL("/#software", Astro.site).href },
    },
  ],
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/webp" href="/mole.webp" />
    <link rel="apple-touch-icon" href="/mole.webp" />
    <meta name="theme-color" content="#ece7db" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Search Console verifies an URL-prefix property by fetching its root, and
        this layout renders the only page there is. The token belongs to the
        property, not to the host serving it, so it is a literal. */}
    <meta
      name="google-site-verification"
      content="6Fs8IePpUHnOCsQg8mlX_ADhWLEmTI8MRm41hPztRvI"
    />

    <link rel="canonical" href={canonical} />

    <!-- Open Graph. The card is public/og.png, 1200x630, generated from the
         logs screenshot with sips; see README. -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={preview} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="mole" />
    <meta property="og:locale" content="en" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={preview} />

    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1"
    />

    <!-- Fonts: IBM Plex Sans Condensed + IBM Plex Sans + IBM Plex Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans+Condensed:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    {/* The tracker of the self-hosted Umami instance. `is:inline` because the
        file is served by that instance and is not bundled here. */}
    {
      umami && (
        <script
          is:inline
          defer
          src={umamiScript}
          data-website-id={umamiWebsiteId}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    <slot />
    <script>
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("revealed")
              obs.unobserve(e.target)
            }
          })
        },
        { threshold: 0.1, rootMargin: "0px 0px -50px 0px" }
      )
      document
        .querySelectorAll("[data-reveal]")
        .forEach((el) => obs.observe(el))
    </script>
  </body>
</html>
