---
import Icon from "@/components/Icon.astro"
import SectionLabel from "@/components/SectionLabel.astro"

const features = [
  {
    icon: "plug",
    title: "One connection",
    desc: "A single SSH client multiplexes every forwarded port.",
  },
  {
    icon: "telescope",
    title: "Smart auto-discover",
    desc: "Enumerates the remote's real TCP listeners (ss/netstat) and forwards them — any port, not a fixed list. Re-scans every 15 s, so servers you start after launch get picked up.",
  },
  {
    icon: "compass",
    title: "SSH config aliases",
    desc: "A remote like dev is resolved through ~/.ssh/config (ssh -G): HostName, User, Port, IdentityFile, Include, Match — all honoured.",
  },
  {
    icon: "shield-check",
    title: "Exclude list",
    desc: "System/reserved ports (22, 25, 53, 111, 631) are skipped by default; fully configurable.",
  },
  {
    icon: "refresh-cw",
    title: "Auto-reconnect",
    desc: "Transparent reconnect on tunnel drop, with periodic health checks.",
  },
  {
    icon: "key-round",
    title: "Native auth",
    desc: "ssh-agent first (Unix socket / Windows named pipe), then ~/.ssh/id_* keys.",
  },
  {
    icon: "moon",
    title: "Background daemon",
    desc: "mole up -d detaches; mole down stops it; mole status and mole logs introspect it.",
  },
  {
    icon: "palette",
    title: "Beautiful logs",
    desc: "mole logs renders the daemon log with colour level badges, a green FORWARD badge, and (×N) collapsing of repeats.",
  },
] as const
---

<section
  id="features"
  data-reveal
  class="scroll-mt-nav relative border-t border-dashed border-border py-16 sm:py-20"
>
  <div
    class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-6 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-12"
  >
    <SectionLabel label="Features" />
    <div>
      <h2
        class="font-display text-4xl font-semibold tracking-tight text-foreground sm:text-5xl"
      >
        What the tunnel carries
      </h2>
      <p class="mt-3 max-w-2xl text-base text-muted-foreground">
        From auto-discovered dev servers to periodic health checks — mole
        removes the busywork of port forwarding.
      </p>

      <div class="mt-10 grid grid-cols-1 gap-x-10 sm:grid-cols-2">
        {
          features.map((f) => (
            <div class="border-t border-border py-5">
              <div class="flex items-center gap-3">
                <Icon name={f.icon} class="size-4 text-forward" />
                <h3 class="font-mono text-sm font-semibold tracking-[0.04em] text-foreground uppercase">
                  {f.title}
                </h3>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                {f.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
