---
import Button from "@/components/Button.astro"
import CopyButton from "@/components/CopyButton.astro"
import Tunnel from "@/components/Tunnel.astro"

const REPO = "https://github.com/Luqueee/mole"
const INSTALL =
  "curl -fsSL https://raw.githubusercontent.com/Luqueee/mole/main/scripts/install.sh | sh"
---

<section id="hero" class="scroll-mt-nav relative pt-16 pb-20 sm:pt-24">
  <div class="mx-auto max-w-6xl px-6">
    <div
      class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)]"
    >
      <div>
        <p
          class="inline-flex items-center gap-2 border border-border px-2 py-1 font-mono text-[11px] tracking-[0.14em] text-muted-foreground uppercase"
        >
          <span class="size-1.5 animate-pulse bg-forward"></span>
          v0.1.0 — single binary · MIT
        </p>

        <h1
          class="mt-6 font-display text-6xl leading-[0.95] font-bold tracking-tight lowercase sm:text-7xl lg:text-8xl"
        >
          mole digs<br />one SSH <span class="text-forward">tunnel</span>.
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">
          Then it forwards every port it finds on the other side. No port lists
          to maintain, no
          <code class="font-mono text-[0.9em] text-foreground">ssh -L</code>
          gymnastics — point it at a remote and localhost mirrors whatever starts
          listening there.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Button size="lg" href="#install">Install mole</Button>
          <Button
            variant="outline"
            size="lg"
            href={REPO}
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </Button>
        </div>

        <div
          class="mt-8 flex max-w-xl items-center justify-between gap-3 rounded-md border border-subsoil/60 bg-subsoil px-4 py-3"
        >
          <code
            class="min-w-0 flex-1 truncate font-mono text-xs text-subsoil-foreground"
            ><span class="text-terminal-green">$</span>&nbsp;{INSTALL}</code
          >
          <CopyButton
            text={INSTALL}
            class="text-subsoil-muted hover:bg-subsoil-foreground/10 hover:text-subsoil-foreground"
          />
        </div>

        <p class="mt-4 font-mono text-xs text-muted-foreground">
          Linux · macOS · Windows · *BSD
        </p>
      </div>

      <Tunnel />
    </div>
  </div>
</section>
