---
import type { HTMLAttributes } from "astro/types"

const variants = {
  default: "border-transparent bg-forward text-background hover:bg-foreground",
  outline:
    "border-border bg-transparent text-foreground hover:bg-foreground hover:text-background",
  ghost: "border-transparent text-muted-foreground hover:text-foreground",
}

const sizes = {
  default: "h-9 gap-1.5 rounded-sm px-4 text-sm",
  sm: "h-7 gap-1 rounded-sm px-2.5 text-[0.8rem]",
  lg: "h-10 gap-1.5 rounded-sm px-5 text-sm",
  "icon-sm": "size-7 rounded-sm text-sm",
}

type Props = HTMLAttributes<"button"> & {
  variant?: keyof typeof variants
  size?: keyof typeof sizes
  href?: string
  target?: string
  rel?: string
}

const {
  variant = "default",
  size = "default",
  class: className,
  href,
  ...rest
} = Astro.props

// Renders an <a> when `href` is given, otherwise a <button> — same visuals.
const Tag = href ? "a" : "button"
---

<Tag
  href={href}
  class:list={[
    "inline-flex shrink-0 items-center justify-center border bg-clip-padding font-mono font-medium tracking-[0.02em] whitespace-nowrap transition-colors outline-none select-none focus-visible:ring-2 focus-visible:ring-forward/60 focus-visible:ring-offset-2 focus-visible:ring-offset-background active:translate-y-px disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4",
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
