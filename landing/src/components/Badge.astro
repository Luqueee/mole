---
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<span
  class:list={[
    "inline-flex h-5 w-fit shrink-0 items-center justify-center overflow-hidden rounded-4xl border border-border px-2 py-0.5 text-xs font-medium whitespace-nowrap text-foreground [&>svg]:pointer-events-none [&>svg]:size-3!",
    className,
  ]}><slot /></span
>
