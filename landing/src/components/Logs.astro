---
import SectionLabel from "@/components/SectionLabel.astro"
import TerminalBlock from "@/components/TerminalBlock.astro"

const lines = [
  { badge: "INFO" as const, content: "14:32:01  starting mole, version 0.1.0" },
  {
    badge: "INFO" as const,
    content: "14:32:01  connected to dev (workstation:22) via ssh-agent",
  },
  {
    badge: "INFO" as const,
    content: "14:32:02  auto-discover: 3 remote ports found",
  },
  { badge: "FORWARD" as const, content: "localhost:3000  →  workstation:3000" },
  { badge: "FORWARD" as const, content: "localhost:5173  →  workstation:5173" },
  { badge: "FORWARD" as const, content: "localhost:8080  →  workstation:8080" },
  {
    badge: "INFO" as const,
    content: "14:32:08  re-discover: 4 remote ports found",
  },
  { badge: "FORWARD" as const, content: "localhost:9090  →  workstation:9090" },
  {
    badge: "UNFWD" as const,
    content: "localhost:8080  pruned (remote closed)",
  },
  { badge: "INFO" as const, content: "14:32:14  ssh tunnel healthy" },
  {
    badge: "INFO" as const,
    content: "14:32:20  forwarded connection on :3000 (×12)",
  },
]
---

<section
  id="logs"
  data-reveal
  class="scroll-mt-nav relative border-t border-dashed border-border py-16 sm:py-20"
>
  <div
    class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-6 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-12"
  >
    <SectionLabel label="Logs" />
    <div>
      <h2
        class="font-display text-4xl font-semibold tracking-tight text-foreground sm:text-5xl"
      >
        Colourised, structured, skimmable
      </h2>
      <p class="mt-3 max-w-2xl text-base text-muted-foreground">
        Every line gets a level badge, a timestamp, and repeated events collapse
        to a single line with a (×N) counter.
      </p>

      <TerminalBlock
        title="mole logs"
        animated={false}
        showCaret={false}
        lines={lines}
        class="mt-8"
      />

      <p class="mt-4 font-mono text-xs leading-relaxed text-muted-foreground">
        <span class="text-forward">FORWARD</span> when a port starts forwarding ·
        <span class="text-unfwd">UNFWD</span> when a dead remote port is pruned ·
        <span class="text-signal">INFO</span> for the rest
      </p>
    </div>
  </div>
</section>
