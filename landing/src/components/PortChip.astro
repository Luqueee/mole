---
interface Props {
  local: string
  remote: string
  status?: "forwarding" | "pending"
}

const { local, remote, status = "forwarding" } = Astro.props
---

<div class="flex items-center gap-2 font-mono text-xs whitespace-nowrap">
  <span
    class:list={[
      "size-1.5 rounded-full",
      status === "forwarding"
        ? "bg-terminal-green"
        : "animate-pulse bg-terminal-orange",
    ]}></span>
  <span class="text-terminal-cyan">{local}</span>
  <span class="text-muted-foreground">→</span>
  <span class="text-foreground">{remote}</span>
</div>
