---
import SectionLabel from "@/components/SectionLabel.astro"

const platforms = [
  {
    name: "Linux",
    install:
      "curl -fsSL https://raw.githubusercontent.com/Luqueee/mole/main/scripts/install.sh | sh",
    hint: "glibc & musl",
    logo: "/logos/linux.svg",
  },
  {
    name: "macOS",
    install:
      "curl -fsSL https://raw.githubusercontent.com/Luqueee/mole/main/scripts/install.sh | sh",
    hint: "Intel & Apple Silicon",
    logo: "/logos/apple.svg",
  },
  {
    name: "Windows",
    install:
      "irm https://raw.githubusercontent.com/Luqueee/mole/main/scripts/install.ps1 | iex",
    hint: "PowerShell 5+",
    logo: "/logos/windows.svg",
  },
  {
    name: "FreeBSD",
    install:
      "curl -fsSL https://raw.githubusercontent.com/Luqueee/mole/main/scripts/install.sh | sh",
    hint: "Unix-like",
    logo: "/logos/freebsd.svg",
  },
]
---

<section
  id="platforms"
  data-reveal
  class="scroll-mt-nav relative border-t border-dashed border-border py-16 sm:py-20"
>
  <div
    class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-6 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-12"
  >
    <SectionLabel label="Platforms" />
    <div>
      <h2
        class="font-display text-4xl font-semibold tracking-tight text-foreground sm:text-5xl"
      >
        Runs on your machine
      </h2>
      <p class="mt-3 max-w-2xl text-base text-muted-foreground">
        Same source, same commands, every desktop OS.
      </p>

      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          platforms.map((p) => (
            <div class="overflow-hidden rounded-md border border-subsoil/60 bg-subsoil">
              <div class="flex items-center gap-2.5 border-b border-subsoil-foreground/15 px-4 py-3">
                <img
                  src={p.logo}
                  alt=""
                  width="22"
                  height="22"
                  loading="lazy"
                  decoding="async"
                  class="size-5.5 shrink-0 object-contain select-none"
                  draggable="false"
                />
                <span class="font-mono text-sm font-semibold text-subsoil-foreground">
                  {p.name}
                </span>
                <span class="ml-auto font-mono text-[11px] text-subsoil-muted">
                  {p.hint}
                </span>
              </div>
              <div class="px-4 py-3">
                {/* prettier-ignore */}
                <pre class="font-mono text-xs break-all whitespace-pre-wrap text-terminal-green">{p.install}</pre>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
