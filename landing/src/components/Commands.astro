---
import Badge from "@/components/Badge.astro"
import Icon from "@/components/Icon.astro"

const commands = [
  {
    cmd: "mole up",
    desc: "Start the forwarder in the foreground (add -d to background it).",
  },
  {
    cmd: "mole down",
    desc: "Stop a backgrounded mole (started with up -d).",
  },
  {
    cmd: "mole status",
    desc: "Query the local admin API for live stats + forwarded ports.",
  },
  {
    cmd: "mole logs",
    desc: "Show the daemon log, colourised; -f to follow.",
  },
  {
    cmd: "mole init",
    desc: "Generate a mole.yaml interactively (or scripted).",
  },
  {
    cmd: "mole update",
    desc: "Update mole in place to the latest release (re-runs the installer).",
  },
  {
    cmd: "mole version · mole help",
    desc: "The obvious.",
  },
]
---

<section id="commands" data-reveal class="scroll-mt-nav relative py-24">
  <div class="relative z-10 mx-auto max-w-5xl px-6">
    <div class="mb-10 flex flex-col items-center gap-3 text-center">
      <Badge class="gap-1.5">
        <Icon name="wrench" class="text-primary" />
        Commands
      </Badge>
      <h2 class="font-mono text-3xl font-bold text-foreground">
        The full CLI surface
      </h2>
      <p class="max-w-2xl text-base text-muted-foreground">
        Eight commands cover the full lifecycle. <span
          class="font-mono text-foreground">mole help</span
        > lists them all.
      </p>
    </div>

    <div class="overflow-x-auto rounded-xl border border-border">
      <table class="w-full caption-bottom text-sm">
        <thead class="[&_tr]:border-b">
          <tr class="border-b bg-secondary">
            <th
              class="h-10 w-[35%] px-2 text-left align-middle font-mono font-medium whitespace-nowrap text-foreground"
              >Command</th
            >
            <th
              class="h-10 px-2 text-left align-middle font-mono font-medium whitespace-nowrap text-foreground"
              >What it does</th
            >
          </tr>
        </thead>
        <tbody class="[&_tr:last-child]:border-0">
          {
            commands.map((c) => (
              <tr class="border-b transition-colors hover:bg-secondary/50">
                {/* prettier-ignore */}
                <td class="p-2 align-middle font-mono whitespace-nowrap text-terminal-cyan">{c.cmd}<span class="ml-2 text-muted-foreground">›</span></td>
                <td class="p-2 align-middle whitespace-nowrap text-muted-foreground">
                  {c.desc}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
