---
import SectionLabel from "@/components/SectionLabel.astro"

const commands = [
  {
    cmd: "mole up",
    desc: "Start the forwarder in the foreground (add -d to background it).",
  },
  {
    cmd: "mole down",
    desc: "Stop a backgrounded mole (started with up -d).",
  },
  {
    cmd: "mole status",
    desc: "Query the local admin API for live stats + forwarded ports.",
  },
  {
    cmd: "mole logs",
    desc: "Show the daemon log, colourised; -f to follow.",
  },
  {
    cmd: "mole init",
    desc: "Generate a mole.yaml interactively (or scripted).",
  },
  {
    cmd: "mole update",
    desc: "Update mole in place to the latest release (re-runs the installer).",
  },
  {
    cmd: "mole version · mole help",
    desc: "The obvious.",
  },
]
---

<section
  id="commands"
  data-reveal
  class="scroll-mt-nav relative border-t border-dashed border-border py-16 sm:py-20"
>
  <div
    class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-6 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-12"
  >
    <SectionLabel label="Commands" />
    <div>
      <h2
        class="font-display text-4xl font-semibold tracking-tight text-foreground sm:text-5xl"
      >
        The full CLI surface
      </h2>
      <p class="mt-3 max-w-2xl text-base text-muted-foreground">
        Eight commands cover the full lifecycle.
        <span class="font-mono text-foreground">mole help</span> lists them all.
      </p>

      <div class="mt-8 overflow-x-auto border border-border">
        <table class="w-full min-w-[34rem] caption-bottom text-sm">
          <thead>
            <tr class="border-b border-border bg-surface">
              <th
                class="h-10 w-[35%] px-3 text-left align-middle font-mono text-xs font-medium tracking-[0.1em] whitespace-nowrap text-muted-foreground uppercase"
                >Command</th
              >
              <th
                class="h-10 px-3 text-left align-middle font-mono text-xs font-medium tracking-[0.1em] whitespace-nowrap text-muted-foreground uppercase"
                >What it does</th
              >
            </tr>
          </thead>
          <tbody>
            {
              commands.map((c) => (
                <tr class="border-b border-border/60 transition-colors last:border-0 hover:bg-surface">
                  {/* prettier-ignore */}
                  <td class="p-3 align-middle font-mono text-xs whitespace-nowrap text-signal">{c.cmd}<span class="ml-2 text-muted-foreground">›</span></td>
                  <td class="p-3 align-middle text-muted-foreground">
                    {c.desc}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
