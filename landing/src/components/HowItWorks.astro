---
import SectionLabel from "@/components/SectionLabel.astro"

const steps = [
  {
    n: "01",
    title: "Connect",
    text: "Open one SSH client connection to the remote. ssh-agent or ~/.ssh/id_* keys; aliases resolved via ssh -G.",
  },
  {
    n: "02",
    title: "Discover",
    text: "Enumerate the remote's TCP listeners (ss/netstat) every 15 s, or fall back to probing discover_ports. Skip exclude_ports.",
  },
  {
    n: "03",
    title: "Forward",
    text: "For each port, bind 127.0.0.1:<port> locally; on a local connection, dial 127.0.0.1:<port> through the tunnel and bridge bytes both ways.",
  },
  {
    n: "04",
    title: "Heal",
    text: "A watchdog reconnects the SSH session if it dies; re-discovery picks up new servers; UNFWD prunes dead ones.",
  },
]
---

<section
  id="how-it-works"
  data-reveal
  class="scroll-mt-nav relative border-t border-dashed border-border py-16 sm:py-20"
>
  <div
    class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-6 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-12"
  >
    <SectionLabel label="How it works" />
    <div>
      <h2
        class="font-display text-4xl font-semibold tracking-tight text-foreground sm:text-5xl"
      >
        Under the hood
      </h2>
      <p class="mt-3 max-w-2xl text-base text-muted-foreground">
        Four goroutines, one SSH client, no port list to maintain.
      </p>

      <ol class="mt-10 grid grid-cols-1 gap-x-12 gap-y-8 sm:grid-cols-2">
        {
          steps.map((s) => (
            <li class="flex gap-5">
              <div class="flex flex-col items-center">
                <span class="font-mono text-xl font-semibold text-forward">
                  {s.n}
                </span>
                <span
                  class="mt-2 w-px flex-1 border-l border-dashed border-border"
                  aria-hidden="true"
                />
              </div>
              <div class="pt-1">
                <h3 class="font-mono text-sm font-semibold tracking-[0.04em] text-foreground uppercase">
                  {s.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                  {s.text}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
