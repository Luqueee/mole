---
import Icon from "@/components/Icon.astro"
import SectionLabel from "@/components/SectionLabel.astro"

const faqs = [
  {
    q: "How is mole different from `ssh -L`?",
    a: "A single SSH client multiplexes every forwarded port. mole auto-discovers what's listening on the remote, so you don't keep a port list. It transparently reconnects when the tunnel drops, and `mole logs` gives you colourised, structured output.",
  },
  {
    q: "Does it work with my existing `~/.ssh/config`?",
    a: "Yes. Pass an alias as the remote (e.g. `mole up --remote dev`) and mole resolves it via `ssh -G` — HostName, User, Port, IdentityFile, Include and Match are all honoured.",
  },
  {
    q: "Where does the binary run — on my laptop or the remote?",
    a: "On your laptop. The remote only needs sshd. The mole daemon opens the SSH connection, enumerates listeners over the encrypted channel, and binds the forwarded ports on 127.0.0.1 locally.",
  },
  {
    q: "What if the SSH connection drops?",
    a: "A watchdog goroutine reconnects the tunnel. Re-discovery picks up any new servers that came up while the connection was down, and a UNFWD badge prunes ports that closed on the remote.",
  },
]
---

<section
  id="faq"
  data-reveal
  class="scroll-mt-nav relative border-t border-dashed border-border py-16 sm:py-20"
>
  <div
    class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-6 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-12"
  >
    <SectionLabel label="FAQ" />
    <div>
      <h2
        class="font-display text-4xl font-semibold tracking-tight text-foreground sm:text-5xl"
      >
        Common questions
      </h2>
      <p class="mt-3 max-w-2xl text-base text-muted-foreground">
        If yours isn't here, the README and the GitHub Issues have the rest.
      </p>

      <div class="mt-8">
        {
          faqs.map((f) => (
            <details class="group border-t border-border py-4 last:border-b [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium text-foreground">
                <span>{f.q}</span>
                <Icon
                  name="chevron-down"
                  class="size-4 shrink-0 text-muted-foreground transition-[rotate] duration-200 group-[[open]]:rotate-180"
                />
              </summary>
              <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted-foreground">
                {f.a}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
