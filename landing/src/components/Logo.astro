---
interface Props {
  size?: number
  withWordmark?: boolean
  tone?: "ink" | "paper"
  class?: string
}

const {
  size = 28,
  withWordmark = true,
  tone = "ink",
  class: className,
} = Astro.props
---

<a
  href="/"
  class:list={[
    "inline-flex items-center gap-2",
    tone === "paper" ? "text-subsoil-foreground" : "text-foreground",
    className,
  ]}
>
  <img
    src="/mole.webp"
    width={size}
    height={size}
    alt={withWordmark ? "" : "mole"}
    class="shrink-0 select-none"
    draggable="false"
  />
  {withWordmark && <span class="font-mono text-lg font-bold">mole</span>}
</a>
