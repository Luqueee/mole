---
const repo = "https://github.com/Luqueee/mole"
---

<footer class="overflow-hidden bg-background">
  <div class="wrap">
    <div
      class="flex flex-col justify-between gap-8 border-b border-line py-10 md:flex-row md:items-start"
    >
      <div>
        <a
          class="inline-flex items-center gap-2 text-[28px] font-bold tracking-[-.06em]"
          href="#">mole<span class="text-hot">_</span></a
        ><p class="mt-3 text-sm text-muted">
          Distance is an implementation detail.
        </p>
      </div>
      <div class="flex flex-wrap gap-x-8 gap-y-4 font-mono text-xs text-muted">
        <a
          class="hover:text-hot"
          href={repo}
          target="_blank"
          rel="noopener noreferrer">SOURCE ↗</a
        ><a
          class="hover:text-hot"
          href={`${repo}#readme`}
          target="_blank"
          rel="noopener noreferrer">DOCS ↗</a
        ><a
          class="hover:text-hot"
          href={`${repo}/releases`}
          target="_blank"
          rel="noopener noreferrer">RELEASES ↗</a
        ><a
          class="hover:text-hot"
          href={`${repo}/issues`}
          target="_blank"
          rel="noopener noreferrer">ISSUES ↗</a
        >
      </div>
    </div>
    <div
      class="flex flex-wrap justify-between gap-4 py-6 font-mono text-xs tracking-wide text-muted"
    >
      <p>OPEN SOURCE. YOUR MACHINES. YOUR RULES.</p><a
        class="hover:text-ink"
        href={`${repo}/blob/main/LICENSE`}
        target="_blank"
        rel="noopener noreferrer">MIT LICENSE ↗</a
      ><a class="hover:text-hot" href="#">BACK TO THE SURFACE ↑</a>
    </div>
    <div
      class="footer-word pointer-events-none -mb-[.21em] text-center text-[clamp(140px,31vw,410px)] leading-[.82] font-bold tracking-[-.09em] text-line select-none"
      aria-hidden="true"
    >
      mole<span class="text-hot">.</span>
    </div>
  </div>
</footer>
