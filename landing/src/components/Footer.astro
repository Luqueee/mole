---
import Logo from "@/components/Logo.astro"

const REPO = "https://github.com/Luqueee/mole"
---

<footer class="border-t border-subsoil/60 bg-subsoil text-subsoil-foreground">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-4">
      <div>
        <Logo size={30} withWordmark={true} tone="paper" />
        <p class="mt-3 max-w-xs text-sm text-subsoil-muted">
          SSH port forwarding, auto-discovered. One binary, one connection, zero
          port lists.
        </p>
      </div>

      <div class="flex flex-col gap-2 text-sm">
        <span
          class="font-mono text-[11px] tracking-[0.16em] text-subsoil-muted uppercase"
          >Project</span
        >
        <a
          href={REPO}
          class="text-terminal-cyan transition-opacity hover:opacity-70"
          target="_blank"
          rel="noopener noreferrer">GitHub</a
        >
        <a
          href={REPO + "#readme"}
          class="text-terminal-cyan transition-opacity hover:opacity-70"
          target="_blank"
          rel="noopener noreferrer">README</a
        >
        <a
          href="#install"
          class="text-terminal-cyan transition-opacity hover:opacity-70"
          >Install</a
        >
      </div>

      <div class="flex flex-col gap-2 text-sm">
        <span
          class="font-mono text-[11px] tracking-[0.16em] text-subsoil-muted uppercase"
          >Resources</span
        >
        <a
          href={REPO + "/issues"}
          class="text-terminal-cyan transition-opacity hover:opacity-70"
          target="_blank"
          rel="noopener noreferrer">Issues</a
        >
        <a
          href={REPO + "/releases"}
          class="text-terminal-cyan transition-opacity hover:opacity-70"
          target="_blank"
          rel="noopener noreferrer">Releases</a
        >
      </div>

      <div class="font-mono text-xs text-subsoil-muted md:text-right">
        MIT License<br />v0.1.0
      </div>
    </div>

    <div class="tunnel-line--muted mt-12 h-px w-full" aria-hidden="true"></div>
    <div class="mt-6 text-center font-mono text-xs text-subsoil-muted">
      Built with Astro · Tailwind
    </div>
  </div>
</footer>
