---
const links = [
  { href: "#overview", label: "Overview" },
  { href: "#how-it-works", label: "Under the hood" },
  { href: "#cli", label: "CLI & daemon" },
]
---

<header
  class="pointer-events-none fixed inset-x-0 top-0 z-50 pt-3.5 max-md:pt-2.5"
>
  <div class="wrap">
  <div
    class="pointer-events-auto border border-line bg-background/92 shadow-[0_10px_40px_-12px_rgba(0,0,0,.6)] backdrop-blur-xl"
  >
  <nav
    class="flex h-14 items-center gap-6 px-5 max-md:gap-3 max-md:px-3"
    aria-label="Main navigation"
  >
    <a
      class="flex items-center gap-2.5 text-[25px] font-bold tracking-[-.06em]"
      href="#"
      aria-label="Mole home"
      ><span
        class="flex size-8 items-center justify-center bg-hot pr-1 font-mono text-xl tracking-[-.15em] text-background"
        aria-hidden="true">m<span class="text-sm">_</span></span
      >mole</a
    >
    <div class="ml-auto flex gap-6 font-mono text-xs text-muted max-md:hidden">
      {
        links.map((link) => (
          <a class="transition-colors hover:text-hot" href={link.href}>
            {link.label}
          </a>
        ))
      }
    </div>
    <a
      class="flex items-center gap-2 border-l border-line pl-6 font-mono text-xs hover:text-hot max-md:ml-auto max-md:border-0 max-md:pl-0"
      href="https://github.com/Luqueee/mole"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Mole on GitHub (opens in a new tab)"
      ><svg
        width="17"
        height="17"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        ><path
          d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.68.08-.68 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.62 1.22 3.26.93.1-.73.39-1.22.71-1.5-2.5-.29-5.13-1.25-5.13-5.54 0-1.22.44-2.22 1.16-3-.12-.29-.5-1.42.11-2.96 0 0 .95-.31 3.08 1.15a10.7 10.7 0 0 1 5.6 0c2.13-1.46 3.07-1.15 3.07-1.15.61 1.54.23 2.67.12 2.96.72.78 1.15 1.78 1.15 3 0 4.3-2.63 5.25-5.14 5.53.4.35.76 1.03.76 2.08v3.1c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8Z"
        ></path></svg
      ><span class="max-sm:hidden">GitHub ↗</span></a
    >
    <a
      class="flex items-center gap-6 border border-[#544d42] px-3.5 py-2.5 font-mono text-xs transition-colors hover:border-hot hover:text-hot max-sm:gap-3"
      href="#install">Get mole <span aria-hidden="true">↗</span></a
    >
    <button
      class="menu-toggle hidden size-10 shrink-0 border border-line bg-transparent p-3 max-md:block"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="mobile-menu"
      ><span class="my-1 block h-px bg-ink"></span><span
        class="my-1 block h-px bg-ink"></span></button
    >
  </nav>
  <div
    class="border-t border-line px-5 pt-2.5 pb-5 md:hidden"
    id="mobile-menu"
    hidden
  >
    {
      links.map((link) => (
        <a
          class="flex justify-between border-b border-line py-4 font-mono text-xs"
          href={link.href}
        >
          {link.label}
          <span aria-hidden="true">↗</span>
        </a>
      ))
    }
  </div>
  </div>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle")
  const menu = document.getElementById("mobile-menu")
  function closeMenu() {
    toggle?.setAttribute("aria-expanded", "false")
    if (menu) menu.hidden = true
  }
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") !== "true"
    toggle.setAttribute("aria-expanded", String(open))
    if (menu) menu.hidden = !open
  })
  menu
    ?.querySelectorAll("a")
    .forEach((link) => link.addEventListener("click", closeMenu))
  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      toggle?.getAttribute("aria-expanded") === "true"
    ) {
      closeMenu()
      toggle.focus()
    }
  })
  matchMedia("(min-width: 768px)").addEventListener("change", (event) => {
    if (event.matches) closeMenu()
  })
</script>


