---
import Button from "@/components/Button.astro"
import Icon from "@/components/Icon.astro"
import Logo from "@/components/Logo.astro"

const REPO = "https://github.com/Luqueee/mole"

const navLinks = [
  { href: "#features", label: "Features" },
  { href: "#how-it-works", label: "How it works" },
  { href: "#install", label: "Install" },
  { href: "#commands", label: "Commands" },
]
---

<nav
  data-nav
  class="scroll-mt-nav sticky top-0 z-50 border-b border-border bg-background/85 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3">
    <Logo size={26} withWordmark={true} />
    <div class="flex items-center gap-1">
      <div class="hidden items-center gap-1 md:flex">
        {
          navLinks.map((l) => (
            <a
              href={l.href}
              class="px-3 py-2 font-mono text-xs tracking-[0.06em] text-muted-foreground uppercase transition-colors hover:text-foreground"
            >
              {l.label}
            </a>
          ))
        }
      </div>
      <Button
        variant="ghost"
        size="sm"
        href={REPO}
        target="_blank"
        rel="noopener noreferrer">GitHub</Button
      >
      <button
        id="nav-toggle"
        aria-expanded="false"
        aria-label="Toggle navigation"
        class="inline-flex size-9 items-center justify-center rounded-sm text-muted-foreground transition-colors hover:bg-surface hover:text-foreground md:hidden"
      >
        <Icon name="menu" class="size-5" />
      </button>
    </div>
  </div>
  <div id="nav-mobile" class="hidden border-t border-border md:hidden">
    <div class="flex flex-col gap-1 px-6 py-3">
      {
        navLinks.map((l) => (
          <a
            href={l.href}
            data-nav-close
            class="px-3 py-2 font-mono text-xs tracking-[0.06em] text-muted-foreground uppercase transition-colors hover:text-foreground"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href={REPO}
        target="_blank"
        rel="noopener noreferrer"
        data-nav-close
        class="px-3 py-2 font-mono text-xs tracking-[0.06em] text-muted-foreground uppercase transition-colors hover:text-foreground"
        >GitHub</a
      >
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById("nav-toggle")
  const menu = document.getElementById("nav-mobile")

  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true"
    toggle.setAttribute("aria-expanded", String(!expanded))
    menu?.classList.toggle("hidden")
  })

  menu?.querySelectorAll("[data-nav-close]").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden")
      toggle?.setAttribute("aria-expanded", "false")
    })
  })
</script>
