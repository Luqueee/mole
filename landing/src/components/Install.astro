---
import CopyButton from "@/components/CopyButton.astro"
import SectionLabel from "@/components/SectionLabel.astro"

const steps = [
  {
    n: 1,
    label: "Install the binary",
    cmd: "curl -fsSL https://raw.githubusercontent.com/Luqueee/mole/main/scripts/install.sh | sh",
  },
  {
    n: 2,
    label: "Configure + start — interactive, accepts an ssh config alias",
    cmd: "mole init",
  },
  {
    n: 3,
    label: "Later",
    cmd: "mole status      # what's forwarded right now\nmole logs -f     # pretty, colourised, live\nmole down        # stop the background daemon",
  },
]
---

<section
  id="install"
  data-reveal
  class="scroll-mt-nav relative border-t border-dashed border-border py-16 sm:py-20"
>
  <div
    class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-6 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-12"
  >
    <SectionLabel label="Install" />
    <div>
      <h2
        class="font-display text-4xl font-semibold tracking-tight text-foreground sm:text-5xl"
      >
        From curl to forwarded ports
      </h2>
      <p class="mt-3 max-w-2xl text-base text-muted-foreground">
        Three commands. Under a minute from download to a live tunnel.
      </p>

      <ol class="mt-10 space-y-6">
        {
          steps.map((s) => (
            <li class="border-t border-border pt-5">
              <div class="flex items-baseline gap-4">
                <span class="font-mono text-xl font-semibold text-forward">
                  {String(s.n).padStart(2, "0")}
                </span>
                <span class="text-sm text-muted-foreground">{s.label}</span>
              </div>
              <div class="mt-3 ml-11 flex items-center justify-between gap-3 rounded-md border border-subsoil/60 bg-subsoil px-4 py-3">
                {/* prettier-ignore */}
                <pre class="min-w-0 flex-1 overflow-x-auto font-mono text-xs whitespace-pre text-subsoil-foreground"><span class="text-terminal-green">$</span>&nbsp;{s.cmd}</pre>
                <CopyButton
                  text={s.cmd}
                  class="text-subsoil-muted hover:bg-subsoil-foreground/10 hover:text-subsoil-foreground"
                />
              </div>
            </li>
          ))
        }
      </ol>

      <p class="mt-6 max-w-2xl text-sm text-muted-foreground">
        <span class="font-mono text-foreground">mole init</span> writes the config,
        then offers to start mole <strong>in the background</strong>
        for you. From there it keeps the tunnel up and forwards new servers as they
        appear.
      </p>
    </div>
  </div>
</section>
