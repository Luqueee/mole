---
interface Props {
  /** mono eyebrow, e.g. "features" */
  label: string
}

const { label } = Astro.props
---

<div class="flex items-center gap-3 md:flex-col md:items-start md:gap-2">
  <span
    class="inline-flex items-center gap-2 font-mono text-[11px] font-medium tracking-[0.18em] text-muted-foreground uppercase"
  >
    <span class="size-1.5 bg-forward"></span>
    {label}
  </span>
  <span
    aria-hidden="true"
    class="h-px flex-1 border-t border-dashed border-border md:w-16 md:flex-none"
  ></span>
</div>
